#include "cuda_core.h"
#include <mp/phase_solver.cuh>

const MP_Parallel MP_parallel;
int Nx = 256, Ny = 256, Nz = 8;
LBE_T T = 0.3;
float LBE_elapsedTime;
h_Array3d<LBE_T> rho(Nx,Ny,Nz), ux(Nx,Ny,Nz), uy(Nx,Ny,Nz), uz(Nx,Ny,Nz);

static phase::Solver<false> solver;

void init() {
    solver.reset(Nx,Ny,Nz,MP_parallel);
}

void cuda_calc() {
    const int steps = 10;
    // The periodic example uses 0.85 in the equation of state in CUP 0.208.
    const float ms = solver.advance(steps,0.6,0.85,0,0);
    LBE_elapsedTime = phase::legacy_ticks(ms,Nx,Ny,Nz,steps);
    solver.download(rho,ux,uy,uz);
}
