	cudaMemcpyPeer(a.p[MP_parallel.GPU_pool.size()-1]+a.Nx*a.Ny*((a.Nz-2)/MP_parallel.GPU_pool.size()+2-1), MP_parallel.GPU_pool[MP_parallel.GPU_pool.size()-1], a.p[0]+a.Nx*a.Ny, MP_parallel.GPU_pool[0], a.Nx*a.Ny*sizeof(LBE_T));
