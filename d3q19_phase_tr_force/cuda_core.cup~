#include <mp/mp.h>
#include <mp/lb3d.h>
#include <mp/d_lb3d.h>

#include "cuda_core.h"

int Nx=256*1;
int Ny=256*1;
int Nz=5;
//int Nz=256+128+64+32;

LBE_T T=0.3, g=1e-5;
float LBE_elapsedTime;


__device__ double p_rho(LBE_T rho, LBE_T T){
    return 8*T*rho/(3-rho)-3*rho*rho;
}

__device__ LBE_T drand(int s){
	for (int i=0; i<100; i++)
		s=(s*s)%(101*127);
	return s/(101.0*127.0);
}

//int a[1]={0};
//MP_Parallel MP_parallel(a, 1);
MP_Parallel MP_parallel;


d_LB3d *lbp;// (Nx, Ny, Nz);
d_Array3d<LBE_T> *psip;   // Массив для вычисления сил
d_Array3d<LBE_T> *fxp;  
d_Array3d<LBE_T> *fyp;
d_Array3d<LBE_T> *fzp;  

h_Array3d<LBE_T> rho(Nx,Ny,Nz), ux(Nx,Ny,Nz), uy(Nx, Ny, Nz), uz(Nx, Ny, Nz);

CUP INSERT core

void init(){
    lbp=new d_LB3d(Nx, Ny, Nz);
    psip=new d_Array3d<LBE_T>(Nx, Ny, Nz);
	fxp=new d_Array3d<LBE_T>(Nx, Ny, Nz);
	fyp=new d_Array3d<LBE_T>(Nx, Ny, Nz);
	fzp=new d_Array3d<LBE_T>(Nx, Ny, Nz);

    d_LB3d &lb=*lbp;
    setrhou(lb, 1.0, 0.0, 0.0, 0.0);

    CUP FORALL_3D_IJK lb lb Nz lb.Nz # 
	int k1=ind+gpuIdx*lb.Nz;
	lb.rho[ind]=0.8 + (drand(k1)-0.5)*0.2;
    #
    rhou2f(lb);
}

void cuda_calc(){
    d_LB3d &lb=*lbp;
    d_Array3d<LBE_T> &psi=*psip;
	d_Array3d<LBE_T> &fx=*fxp;
	d_Array3d<LBE_T> &fy=*fyp;
	d_Array3d<LBE_T> &fz=*fzp;

    cudaEvent_t start, stop;
    cudaEventCreate(&start);
    cudaEventCreate(&stop);
    cudaEventRecord(start, 0);
    int NN=10;
    for(int i=0; i<NN; i++){
		transfer(lb);
		f2rhou(lb);
		relax(lb, 0.6);
		sync(lb);
		periodicz(lb); periodicx(lb); //periodicy(lb);
		CUP FORALL_3DXZ lb lb Nxy lb.Nx*(lb.Ny-1) #
			set_value(lb, ind, lb.rho[ind+lb.Nx], 0.0, 0.0, 0.0);
			set_value(lb, ind+Nxy, lb.rho[ind+Nxy-lb.Nx], 0.0, 0.0, 0.0);
		#
	
		// Вычисление сил для уравнения состояния
		CUP FORALL_3D rho lb.rho psi psi # 
		    psi[ind]=sqrt(fabs(rho[ind]/3.0-0.02*p_rho(rho[ind], 0.85))); 
		#
		CUP FORALL_3D fx fx fy fy fz fz rho lb.rho g g # 
		    fx[ind]=0.0;
			fy[ind]=g*rho[ind];
			fz[ind]=0.0; 
		#
		psi2force(fx, fy, fz, psi);
		force(lb, fx, fy, fz);
		sync(lb);
		periodicz(lb); periodicx(lb); // periodicy(lb);
		CUP FORALL_3DXZ lb lb Nxy lb.Nx*(lb.Ny-1) #
			set_value(lb, ind, lb.rho[ind+lb.Nx], 0.0, 0.0, 0.0);
			set_value(lb, ind+Nxy, lb.rho[ind+Nxy-lb.Ny], 0.0, 0.0, 0.0);
		#
	
    }

    cudaEventRecord(stop, 0);
    cudaEventSynchronize(stop);
    float elapsedTime_;
    cudaEventElapsedTime(&elapsedTime_, start, stop);

    LBE_elapsedTime=elapsedTime_/(Nx*Ny*Nz*NN)*LBE_ncores*LBE_gpuf*1e-3;
 
    cpy(rho, lb.rho);
    cpy(ux, lb.ux);
    cpy(uy, lb.uy);
    cpy(uz, lb.uz);
}
